# Taskwarrior. Shown in waybar as "yawm" (~/.local/bin/waybar-yawm):
#   click        list popup   (~/.local/bin/quartermile-yawm -> quartermile-yawm-menu)
#   right-click  quick add    (~/.local/bin/quartermile-yawm add)
# Tasks tagged +note are notes: listed last, never counted in the bar.

data.location=~/.local/share/task
news.version=3.5.0
editor=nvim
weekstart=monday

# Quarter Mile day colours (256-colour approximations): overdue in tree red,
# due today in tree amber, active in tree green, notes in blue.
color.due.today=bold rgb310
color.due=gray6
color.overdue=bold rgb300
color.tag.note=rgb013
color.active=rgb020
color.header=gray8
color.label=gray8
color.footnote=gray10
