#!/usr/bin/env bash
# Quarter Mile launcher: a floating foot window running fzf over desktop entries,
# set like a timeslip (Courier Prime, a chequer rule under the prompt). Hyprland gives
# it the chrome border and the shadow (see hypr/quartermile-night.lua); foot requests the blur
# through ext-background-effect.
# Pressing the bind again while it is open closes it.
set -euo pipefail

if hyprctl clients -j | grep -q '"class": "quartermile-launcher"'; then
    hyprctl eval 'quartermile_close_launcher()' >/dev/null
    exit 0
fi

exec foot \
    --app-id=quartermile-launcher \
    --title=Launcher \
    -o main.pad=18x14 \
    -o main.font="Courier Prime:size=12" \
    -o main.line-height=22 \
    -o colors-dark.alpha=0.94 \
    -o colors-light.alpha=0.94 \
    "$HOME/.local/bin/quartermile-launcher-menu"
